{
  "expo": {
    "name": "DeviceResourcesApp",
    "slug": "DeviceResourcesApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leoferreira.deviceresourcesapp",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Este aplicativo precisa acessar sua galeria de fotos.",
        "NSContactsUsageDescription": "Este aplicativo precisa acessar seus contatos."
      }
    },
    "android": {
      "package": "com.leoferreira.deviceresourcesapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
